# Copia este archivo como .env y completa los valores (NUNCA subas .env a GitHub)

# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "service_role" (secreta, solo en el servidor; no la pongas en el frontend)
SUPABASE_SERVICE_KEY=

# Cadena larga y aleatoria para firmar sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Usuario máster inicial (solo se crea si aún no existe ningún máster)
MASTER_USER=master
MASTER_PASS=

PORT=3000
# En producción (Render, Railway, VPS con HTTPS):
# NODE_ENV=production
